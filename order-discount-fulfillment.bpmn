<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  id="Definitions_OrderDiscount"
  targetNamespace="http://example.com/camunda/order-discount">
  <bpmn:process id="OrderDiscountFulfillment" name="Multi-Item Order Discount &amp; Fulfillment" isExecutable="true">
    <bpmn:startEvent id="Start_Order" name="Order received">
      <bpmn:outgoing>Flow_O1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_Discount" name="Calculate Total Discount"
      camunda:decisionRef="calculate-discounts"
      camunda:mapDecisionResult="singleEntry"
      camunda:resultVariable="totalDiscount">
      <bpmn:incoming>Flow_O1</bpmn:incoming>
      <bpmn:outgoing>Flow_O2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Task_FinalAmount" name="Calculate Final Invoice Amount" scriptFormat="groovy">
      <bpmn:incoming>Flow_O2</bpmn:incoming>
      <bpmn:outgoing>Flow_O3</bpmn:outgoing>
      <bpmn:script>execution.setVariable("finalAmount", cartValue * (1 - (totalDiscount / 100.0)))</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_Invoice" name="Manager sign-off required?">
      <bpmn:incoming>Flow_O3</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager</bpmn:outgoing>
      <bpmn:outgoing>Flow_Direct</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Manager" name="Manager Sign-off">
      <bpmn:incoming>Flow_Manager</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerWarehouse</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Warehouse" name="Send Order to Warehouse">
      <bpmn:incoming>Flow_ManagerWarehouse</bpmn:incoming>
      <bpmn:incoming>Flow_Direct</bpmn:incoming>
      <bpmn:outgoing>Flow_WarehouseEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Order" name="Order completed">
      <bpmn:incoming>Flow_WarehouseEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_O1" sourceRef="Start_Order" targetRef="Task_Discount"/>
    <bpmn:sequenceFlow id="Flow_O2" sourceRef="Task_Discount" targetRef="Task_FinalAmount"/>
    <bpmn:sequenceFlow id="Flow_O3" sourceRef="Task_FinalAmount" targetRef="Gateway_Invoice"/>
    <bpmn:sequenceFlow id="Flow_Manager" name="finalAmount &gt;= 1000" sourceRef="Gateway_Invoice" targetRef="Task_Manager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">= finalAmount &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Direct" name="finalAmount &lt; 1000" sourceRef="Gateway_Invoice" targetRef="Task_Warehouse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="feel">= finalAmount &lt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerWarehouse" sourceRef="Task_Manager" targetRef="Task_Warehouse"/>
    <bpmn:sequenceFlow id="Flow_WarehouseEnd" sourceRef="Task_Warehouse" targetRef="End_Order"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" id="BPMNDiagram_Order">
    <bpmndi:BPMNPlane id="BPMNPlane_Order" bpmnElement="OrderDiscountFulfillment">
      <bpmndi:BPMNShape id="Shape_OStart" bpmnElement="Start_Order"><dc:Bounds x="80" y="180" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Discount" bpmnElement="Task_Discount"><dc:Bounds x="150" y="158" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Final" bpmnElement="Task_FinalAmount"><dc:Bounds x="360" y="158" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Invoice" bpmnElement="Gateway_Invoice" isMarkerVisible="true"><dc:Bounds x="580" y="173" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Manager" bpmnElement="Task_Manager"><dc:Bounds x="700" y="70" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Warehouse" bpmnElement="Task_Warehouse"><dc:Bounds x="700" y="210" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_OEnd" bpmnElement="End_Order"><dc:Bounds x="930" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_O1" bpmnElement="Flow_O1"><di:waypoint x="116" y="198"/><di:waypoint x="150" y="198"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O2" bpmnElement="Flow_O2"><di:waypoint x="320" y="198"/><di:waypoint x="360" y="198"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_O3" bpmnElement="Flow_O3"><di:waypoint x="540" y="198"/><di:waypoint x="580" y="198"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Manager" bpmnElement="Flow_Manager"><di:waypoint x="605" y="173"/><di:waypoint x="605" y="110"/><di:waypoint x="700" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Direct" bpmnElement="Flow_Direct"><di:waypoint x="630" y="198"/><di:waypoint x="665" y="198"/><di:waypoint x="665" y="250"/><di:waypoint x="700" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ManagerWarehouse" bpmnElement="Flow_ManagerWarehouse"><di:waypoint x="775" y="150"/><di:waypoint x="775" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_WarehouseEnd" bpmnElement="Flow_WarehouseEnd"><di:waypoint x="870" y="250"/><di:waypoint x="930" y="250"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
